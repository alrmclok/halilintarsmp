---
// The frame of every page: header, yellow tabs, maroon bar, footer.
const { title = 'HalilintarSMP', description = 'the community website of the HalilintarSMP' } = Astro.props;
const fullTitle = title === 'HalilintarSMP' ? title : `${title} | HalilintarSMP`;
const path = Astro.url.pathname;
const SITE = 'https://halilintarsmp.vercel.app'; // if you get your own domain, change only this line
const PREVIEW_IMAGE = '/putinxtrump.png'; // tab icon + link preview picture (a file in public/)
const pageUrl = new URL(path, SITE).href;
const imageUrl = new URL(PREVIEW_IMAGE, SITE).href;
const tabs = [
  { label: 'Home', href: '/' },
  { label: 'Members', href: '/members/' },
  { label: 'Fandoms', href: '/fandoms/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'About', href: '/about/' },
];
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HalilintarSMP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <link rel="canonical" href={pageUrl} />
    <link rel="stylesheet" href="/style.css" />
    <link rel="icon" type="image/png" href={PREVIEW_IMAGE} />
  </head>
  <body>
  <div class="corner-fig-wrap left-wrap">
      <span class="fig-close" title="Remove figure">× Remove</span>
      <img src="/figures/figuret.png" alt="" class="corner-fig" />
    </div>
    <div class="corner-fig-wrap right-wrap">
      <span class="fig-close" title="Remove figure">× Remove</span>
      <img src="/figures/figurep.png" alt="" class="corner-fig" />
    </div>
    <div class="wrap">
      <header class="top">
        <a class="logo" href="/"><img src="/halilintarsmp-logo.png" alt="HalilintarSMP" /></a>
      </header>
      <div class="navrow">
        <nav class="tabs" aria-label="Main">
          {tabs.map((t) => <a href={t.href} aria-current={isActive(t.href) ? 'page' : undefined}>{t.label}</a>)}
        </nav>
        <div class="corner">
          <a href="/join/">Discord</a>
          <a href="/join/">WhatsApp</a>
        </div>
      </div>
      <div class="subbar">
        <div class="subbar-links">
          <a href="/join/">Join</a>
          <a href="/rules/">Rules</a>
          <a href="/join/#server-address">Server address</a>
          <a href="/news/">News</a>
        </div>
        <!-- Search box. public/search.js adds the dropdown. Without JavaScript, GO searches the Members list. -->
        <form class="search" role="search" action="/members/" method="get">
          <span>Search</span>
          <input id="site-search" type="search" name="q" aria-label="Search" autocomplete="off" enterkeyhint="search" role="combobox" aria-expanded="false" aria-controls="search-drop" aria-autocomplete="list" />
          <button type="submit">GO</button>
          <div class="search-drop" id="search-drop" role="listbox" aria-label="Search results" hidden></div>
        </form>
      </div>
      <main class="page"><slot /></main>
      <footer>
        <div class="footer">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/credits/">Credits</a></li>
          </ul>
        </div>
        <p class="copy">futer 2</p>
      </footer>
    </div>
    <script is:inline src="/search.js" defer></script>
    <script is:inline>
      document.querySelectorAll('.corner-fig-wrap').forEach((wrap) => {
        wrap.addEventListener('click', () => {
          wrap.classList.add('fade-out');
          setTimeout(() => wrap.remove(), 500);
        });
      });
    </script>
  </body>
</html>
