---
// The list for one section (members, fandoms, gallery or news), with Hide / Unhide.
import Base from '../../../layouts/Base.astro';
import Box from '../../../components/Box.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { adminDb } from '../../../lib/auth';
import { KINDS, setHidden, type Kind } from '../../../lib/admin';

export const prerender = false;

const kind = Astro.params.kind as Kind;
if (!Object.hasOwn(KINDS, kind)) return new Response(null, { status: 404 });
const cfg = KINDS[kind];

let err = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  err = (await setHidden(kind, String(f.get('id') ?? ''), f.get('hidden') === '1')) ?? '';
  if (!err) return Astro.redirect(`/admin/${kind}/?saved=1`, 303);
}

const { data, error } = await adminDb().from(kind).select('*').order(cfg.order[0], { ascending: cfg.order[1] });
if (error) err = error.message;
---
<Base title={`Admin: ${cfg.label}`} description="HalilintarSMP admin.">
  <Box title={cfg.label}>
    <AdminNav current={`/admin/${kind}/`} />
    {Astro.url.searchParams.get('saved') && <p class="adm-ok">Saved. Press Publish on the dashboard to show it on the site.</p>}
    {err && <p class="adm-err">{err}</p>}
    <a class="adm-btn" href={`/admin/${kind}/new/`}>+ New {cfg.one}</a>
    <ul class="adm-list">
      {(data ?? []).map((r: any) => (
        <li>
          <div class="grow">
            <strong>{cfg.title(r)}</strong>{r.hidden && <span class="adm-tag"> hidden</span>}
            <small class="adm-help">{cfg.sub(r)}</small>
          </div>
          <a class="adm-btn" href={`/admin/${kind}/${r.id}/`}>Edit</a>
          <form method="post">
            <input type="hidden" name="id" value={r.id} />
            <input type="hidden" name="hidden" value={r.hidden ? '0' : '1'} />
            <button type="submit">{r.hidden ? 'Unhide' : 'Hide'}</button>
          </form>
        </li>
      ))}
    </ul>
  </Box>
</Base>
