---
// The list for one section (members, fandoms, gallery or news), with Hide / Unhide.
import Base from "../../../layouts/Base.astro";
import Box from "../../../components/Box.astro";
import AdminNav from "../../../components/AdminNav.astro";
import { adminDb } from "../../../lib/auth";
import { KINDS, setHidden, deleteRow, type Kind } from "../../../lib/admin";

export const prerender = false;

const kind = Astro.params.kind as Kind;
if (!Object.hasOwn(KINDS, kind)) return new Response(null, { status: 404 });
const cfg = KINDS[kind];

const isSuper = Astro.locals.user.role === "super";

let err = "";
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const id = String(f.get("id") ?? "");
  if (f.get("action") === "delete") {
    err = (await deleteRow(kind, id, String(f.get("confirm") ?? ""))) ?? "";
    if (!err) return Astro.redirect(`/admin/${kind}/?deleted=1`, 303);
  } else {
    err = (await setHidden(kind, id, f.get("hidden") === "1")) ?? "";
    if (!err) return Astro.redirect(`/admin/${kind}/?saved=1`, 303);
  }
}

const { data, error } = await adminDb()
  .from(kind)
  .select("*")
  .order(cfg.order[0], { ascending: cfg.order[1] });
if (error) err = error.message;
---

<Base title={`Admin: ${cfg.label}`} description="HalilintarSMP admin.">
  <Box title={cfg.label}>
    <AdminNav current={`/admin/${kind}/`} />
    {Astro.url.searchParams.get("saved") && (
      <p class="adm-ok" role="status">
        Saved. Press Publish on the dashboard to show it on the site.
      </p>
    )}
    {Astro.url.searchParams.get("deleted") && (
      <p class="adm-ok" role="status">Deleted for good.</p>
    )}
    {err && (
      <p class="adm-err" role="alert">
        {err}
      </p>
    )}
    <a class="adm-btn" href={`/admin/${kind}/new/`}>
      + New {cfg.one}
    </a>
    <ul class="adm-list">
      {(data ?? []).map((r: any) => (
        <li>
          <div class="grow">
            <strong>{cfg.title(r)}</strong>
            {r.hidden && <span class="adm-tag"> hidden</span>}
            <small class="adm-help">{cfg.sub(r)}</small>
          </div>
          <a class="adm-btn" href={`/admin/${kind}/${r.id}/`}>
            Edit
          </a>
          <form method="post">
            <input type="hidden" name="id" value={r.id} />
            <input type="hidden" name="hidden" value={r.hidden ? "0" : "1"} />
            <button type="submit">{r.hidden ? "Unhide" : "Hide"}</button>
          </form>
          {isSuper && r.hidden && (
            <details class="del">
              <summary>Delete…</summary>
              <form method="post">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={r.id} />
                <label>Type DELETE <input name="confirm" autocomplete="off" required /></label>
                <button type="submit">Delete for good</button>
              </form>
            </details>
          )}
        </li>
      ))}
    </ul>
    {!err && (data ?? []).length === 0 && (
      <p class="adm-help">
        Nothing here yet. Press "+ New {cfg.one}" to add the first one.
      </p>
    )}
  </Box>
</Base>

<style>
  .del summary { cursor: pointer; padding: 0.6em 0.4em; }
  .del form { display: flex; flex-wrap: wrap; gap: 0.4em; align-items: center; }
</style>
