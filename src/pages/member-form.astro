---
// Private member profile submission form with unlimited dynamic wiki sections.
import Base from '../layouts/Base.astro';
import Box from '../components/Box.astro';

const WEB3FORMS_KEY = 'c7289670-08b3-49c8-bc26-8463b6b431c7'; // Get a free key at https://web3forms.com
---
<Base title="Member Wiki Form" description="Submit your member profile details for the HalilintarSMP directory.">
  <div class="form-wrap">
    <Box title="Member Wiki Submission">
      <div id="form-status" class="status-banner" hidden></div>

      <form id="member-form" class="smp-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="HalilintarSMP — New Member Profile" />
        <input type="checkbox" name="botcheck" style="display: none;" />

        <p class="form-note">
        Fill out your details below to submit your page for the <strong>Members</strong> directory.
        Fields marked with <span class="req">*</span> are required. For your profile picture, send your image directly to Almira.
        </p>

        <div class="field">
          <label for="f-name">Display Name <span class="req">*</span></label>
          <input id="f-name" type="text" name="name" placeholder="Name shown on your wiki page" required />
        </div>

        <div class="field">
          <label for="f-handle">Handle / Username <span class="req">*</span></label>
          <input id="f-handle" type="text" name="handle" placeholder="e.g. your handle or IGN" required />
        </div>

        <div class="field">
            <label for="f-pronouns">Pronouns</label>
            <input id="f-pronouns" type="text" name="pronouns" placeholder="e.g. she/her, he/him, they/them" />
        </div>

        <div class="field">
          <label for="f-fandoms">Fandoms</label>
          <input id="f-fandoms" type="text" name="fandoms" placeholder="Separate multiple fandoms with commas" />
        </div>

        <div class="field">
            <label for="f-joined">When did you join HalilintarSMP?</label>
            <input id="f-joined" type="date" name="joined" />
        </div>

        <div class="field">
          <label for="f-intro">Short Intro <span class="req">*</span></label>
          <textarea id="f-intro" name="intro" rows="2" placeholder="1–2 sentences shown at the top of your page and on your member card..." required></textarea>
        </div>

        <!-- Dynamic Wiki Sections Container -->
        <div id="sections-list">
          <div class="section-block" data-section>
            <div class="section-bar">
              <span class="section-num">Section 1</span>
            </div>
            <div class="field-inner">
              <label>Heading <span class="req">*</span></label>
              <input type="text" data-sec-heading value="About" required />
            </div>
            <div class="field-inner">
              <label>Text <span class="req">*</span></label>
              <textarea data-sec-text rows="5" placeholder="Write your wiki bio here. Leave an empty line between paragraphs..." required></textarea>
            </div>
          </div>
        </div>

        <div class="add-row">
          <button type="button" class="btn-add" id="add-section-btn">+ Add Another Section</button>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-submit" id="submit-btn">Send Profile</button>
        </div>
      </form>
    </Box>
  </div>
</Base>

<script is:inline>
  const form = document.getElementById('member-form');
  const status = document.getElementById('form-status');
  const btn = document.getElementById('submit-btn');
  const sectionsList = document.getElementById('sections-list');
  const addBtn = document.getElementById('add-section-btn');

  function renumberSections() {
    const blocks = sectionsList.querySelectorAll('[data-section]');
    blocks.forEach((block, i) => {
      block.querySelector('.section-num').textContent = `Section ${i + 1}`;
    });
  }

  addBtn?.addEventListener('click', () => {
    const count = sectionsList.querySelectorAll('[data-section]').length + 1;
    const block = document.createElement('div');
    block.className = 'section-block';
    block.setAttribute('data-section', '');
    block.innerHTML = `
      <div class="section-bar">
        <span class="section-num">Section ${count}</span>
        <button type="button" class="btn-remove">Remove</button>
      </div>
      <div class="field-inner">
        <label>Heading <span class="req">*</span></label>
        <input type="text" data-sec-heading placeholder="e.g. Trivia, Builds, Lore, Favorites..." required />
      </div>
      <div class="field-inner">
        <label>Text <span class="req">*</span></label>
        <textarea data-sec-text rows="4" placeholder="Write section text... Leave an empty line between paragraphs." required></textarea>
      </div>
    `;
    sectionsList.appendChild(block);
    block.querySelector('input').focus();
  });

  sectionsList?.addEventListener('click', (e) => {
    if (e.target.classList.contains('btn-remove')) {
      e.target.closest('[data-section]').remove();
      renumberSections();
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Sending...';
    status.hidden = true;

    const name = form.querySelector('[name="name"]').value.trim();
    const handle = form.querySelector('[name="handle"]').value.trim();
    const pronouns = form.querySelector('[name="pronouns"]').value.trim();
    const joined = form.querySelector('[name="joined"]').value.trim();
    const rawFandoms = form.querySelector('[name="fandoms"]').value;
    const fandoms = rawFandoms
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    const intro = form.querySelector('[name="intro"]').value.trim();

    const sections = [];
    sectionsList.querySelectorAll('[data-section]').forEach((block) => {
      const heading = block.querySelector('[data-sec-heading]').value.trim();
      const text = block.querySelector('[data-sec-text]').value.trim();
      if (heading || text) {
        sections.push({ heading, text });
      }
    });

    const memberJson = {
      name,
      handle,
      ...(pronouns && { pronouns }), // Includes pronouns only if they typed one
      picture: '/putinxtrump.png',
      fandoms,
      joined,
      intro,
      custom: false,
      sections,
    };

    const formData = new FormData();
    formData.append('access_key', form.querySelector('[name="access_key"]').value);
    formData.append('subject', `HalilintarSMP Member: ${name} (@${handle})`);
    formData.append('name', name);
    formData.append('handle', handle);
    formData.append('Ready-to-Paste JSON', JSON.stringify(memberJson, null, 2));

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Accept': 'application/json'
        },
        body: formData,
      });
      const data = await res.json();

      if (data.success) {
        status.className = 'status-banner status-ok';
        status.textContent = 'Submitted! Your member profile has been sent to the admins.';
        status.hidden = false;
        form.reset();
        const extras = sectionsList.querySelectorAll('[data-section]');
        extras.forEach((el, idx) => {
          if (idx > 0) el.remove();
        });
        renumberSections();
      } else {
        throw new Error(data.message || 'Submission failed');
      }
    } catch (err) {
      status.className = 'status-banner status-err';
      status.textContent = 'Something went wrong. Please try again or message an admin directly.';
      status.hidden = false;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Profile';
      status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
</script>