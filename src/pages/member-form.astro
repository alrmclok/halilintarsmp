---
// Part Q: the public form for a NEW member. It saves a pending request (see src/pages/api/request.ts).
import Base from '../layouts/Base.astro';
import Box from '../components/Box.astro';
import RequestForm from '../components/RequestForm.astro';
---
<Base title="Member Wiki Form" description="Send your member profile for the HalilintarSMP directory." noindex>
  <div class="form-wrap">
    <Box title="Member Wiki Submission">
      <p class="form-note">
        Fill out your details to ask for a page in the <strong>Members</strong> directory. An admin reads every request before it goes live.
        Fields marked with <span class="req">*</span> are required. For your profile picture, send your image directly to Almira.
      </p>
      <RequestForm type="member-new" />
    </Box>
  </div>
</Base>
