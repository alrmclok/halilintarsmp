---
// The Fandoms list: every fandom, A to Z, with how many members it has. Each row links to /fandoms/name/.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Box from '../../components/Box.astro';
import Row from '../../components/Row.astro';
import { getFandoms } from '../../lib/fandoms.js';

const entries = await getCollection('members');
const fandoms = getFandoms(entries.map((e) => ({ ...e.data, slug: e.id })));
---
<Base title="Fandoms" description="The fandoms of the HalilintarSMP members.">
  <Box title="Fandoms">
    {fandoms.map((f) => (
      <Row href={`/fandoms/${f.slug}/`} title={f.name} sub={`${f.count} ${f.count === 1 ? 'member' : 'members'}`} />
    ))}
  </Box>
</Base>
