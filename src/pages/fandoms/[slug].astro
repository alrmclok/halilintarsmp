---
// One fandom page (a wiki "category" page): a short list of the members in that fandom.
// Made from the member data files. Members with a custom page are listed too, and link to their own folder.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Box from '../../components/Box.astro';
import Row from '../../components/Row.astro';
import { getFandoms } from '../../lib/fandoms.js';

export async function getStaticPaths() {
  const entries = await getCollection('members');
  const fandoms = getFandoms(entries.map((e) => ({ ...e.data, slug: e.id })));
  return fandoms.map((f) => ({ params: { slug: f.slug }, props: { fandom: f } }));
}

const { fandom } = Astro.props;
---
<Base title={fandom.name} description={`Members of the HalilintarSMP in the ${fandom.name} fandom.`}>
  <Box title={fandom.name} moreHref="/fandoms/" moreLabel="All fandoms">
    {fandom.members.map((m) => (
      <Row href={`/members/${m.slug}/`} title={m.name} sub={m.handle} pic={m.picture} />
    ))}
  </Box>
</Base>
