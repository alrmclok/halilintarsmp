---
// Links across the top of every admin page, plus the shared plain-form styles.
const { current = '' } = Astro.props;
const links = [
  ['/admin/', 'Dashboard'],
  ['/admin/members/', 'Members'],
  ['/admin/fandoms/', 'Fandoms'],
  ['/admin/gallery/', 'Gallery'],
  ['/admin/news/', 'News'],
  ['/admin/requests/', 'Requests'],
  ['/admin/log/', 'Log'],
];
if (Astro.locals.user?.role === 'super') links.push(['/admin/super/', 'Super-admin']);
---
<nav class="adm-nav" aria-label="Admin">
  {links.map(([href, label]) => <a href={href} aria-current={href === current ? 'page' : undefined}>{label}</a>)}
  <form method="post" action="/admin/logout/"><button type="submit">Log out</button></form>
</nav>
