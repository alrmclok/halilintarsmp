---
// The box: maroon title bar, yellow "More" link, light body.
// Use it as <Box title="Members" moreHref="/members/" moreLabel="More members"> ...rows... </Box>
const { title, moreHref, moreLabel, id } = Astro.props;
---
<section class="box" id={id}>
  <div class="box-head">
    <h2>{title}</h2>
    {moreHref && <a class="more" href={moreHref}>{moreLabel ?? 'More'}</a>}
  </div>
  <div class="box-body"><slot /></div>
</section>
