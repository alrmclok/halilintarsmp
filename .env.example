# Copy this file to a new file called .env and fill in the values. Never commit .env (it is in .gitignore).
# Where to find the keys: Supabase dashboard > your project > Settings > API Keys.

# --- Needed from Part M on ---
# The project address, like https://abcdefgh.supabase.co
PUBLIC_SUPABASE_URL=
# The publishable key (starts with sb_publishable_). Safe for the browser: it can only read visible rows.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (starts with sb_secret_). SERVER AND YOUR COMPUTER ONLY. Never share it, never put it in a chat or a screenshot.
SUPABASE_SECRET_KEY=
# Super-admin email
SUPER_ADMIN_EMAIL=

# --- Not needed yet (later parts) ---
# Part O: the Google email of the super-admin
SUPER_ADMIN_EMAIL=
# Part P: the Vercel deploy hook address that the Publish button calls
VERCEL_DEPLOY_HOOK_URL=
# Part S: protects the weekly keep-alive call
CRON_SECRET=