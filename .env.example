# HalilintarSMP: environment variables.
# Copy this file to a new file called .env and fill in the values. Never commit .env (it is in .gitignore).
# Every value here must ALSO be set in Vercel (Project > Settings > Environment Variables, Production), then redeploy.
# Names starting with PUBLIC_ are sent to the browser, so they must be safe to show. The others never leave the server.

# =============================================================================
# Supabase (Part M)
# Find the keys at: Supabase dashboard > your project > Settings > API Keys.
# =============================================================================

# The project address, like https://abcdefgh.supabase.co
PUBLIC_SUPABASE_URL=

# The publishable key (starts with sb_publishable_). Safe for the browser: it can only read visible rows.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (starts with sb_secret_). SERVER AND YOUR COMPUTER ONLY.
# It ignores all access rules. Never share it, never put it in a chat or a screenshot.
# If it ever leaks: Supabase > Settings > API Keys, make a new one, delete the old one, and update Vercel.
SUPABASE_SECRET_KEY=

# =============================================================================
# Admin login and Publish (Parts O and P)
# =============================================================================

# The Google email of the super-admin (you). Must be the exact email of the Google account you log in with.
SUPER_ADMIN_EMAIL=

# The Vercel deploy hook address that the Publish button calls.
# Vercel > Project > Settings > Git > Deploy Hooks. Treat the address like a password: anyone with it can trigger a build.
VERCEL_DEPLOY_HOOK_URL=

# =============================================================================
# Request forms spam check (Part Q), Cloudflare Turnstile
# Cloudflare dashboard > Turnstile > your widget. The site key is public, the secret key is not.
# For local testing you can use Cloudflare's test keys (the check always passes):
#   site key 1x00000000000000000000AA   secret key 1x0000000000000000000000000000000AA
# Use the real keys in Vercel.
# =============================================================================

PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Keep-alive (Part S)
# Protects /api/keepalive, which Vercel calls every 5 days so the free Supabase project does not pause.
# Make a long random text and use the same value here and in Vercel (Vercel sends it to the cron job by itself):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Treat it like a password. Without it, the endpoint refuses every call.
# =============================================================================

CRON_SECRET=